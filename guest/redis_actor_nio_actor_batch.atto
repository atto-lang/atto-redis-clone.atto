// Experimental native Atto single-client mailbox-batch Redis path.
// One real Atto actor owns the complete Map<Bytes,Bytes>.
// One finite 1..16-command NIO2 input batch becomes ONE typed actor mail;
// it returns ONE bounded ordered typed reply list. No Java/Rust KV and
// no blocking I/O. This must be measured against the per-command actor path.
define actor BatchedBytesKvActor implements StreamOperator<List<Tuple[int, Bytes, Bytes]>, List<Tuple[string, Bytes]>> as
  let Map<Bytes,Bytes> values;

  on_start(): void {
    self.values = ~map<Bytes,Bytes>();
    return;
  }

  receive(ActorMail<List<Tuple[int, Bytes, Bytes]>> mail): void {
    const List<Tuple[int, Bytes, Bytes]> commands = mail.value;
    // Empty control batch is a shutdown signal; only the owning guest
    // connection sends it, after all previous data mail is acknowledged.
    if commands.size == 0; do
      self.end();
      return;
    fi
    let mut List<Tuple[string, Bytes]> results = [];
    let int i = 0;
    loop {
      if i == commands.size then break; fi
      const Tuple[int, Bytes, Bytes] command = commands.get(i);
      const int kind = command[0];
      const Bytes key = command[1];
      const Bytes value = command[2];
      if kind == 1; do
        results.add(("PONG", value));
      elseif kind == 3; do
        self.values.set(key, value);
        results.add(("OK", value));
      elseif kind == 2; do
        val found = self.values.get_optional(key);
        if found.is_none(); do
          results.add(("NIL", value));
        else
          results.add(("VALUE", found.unwrap()));
        fi
      elseif kind == 4; do
        if self.values.delete(key); do
          results.add(("ONE", value));
        else
          results.add(("ZERO", value));
        fi
      else
        results.add(("ERR", value));
      fi
      i = i + 1;
    }
    // Atomic reply order for the entire batch: no second actor wakeup
    // between commands. The guest reader never admits more than 16.
    self.send(results);
    return;
  }
end

pub async routine main(): void {
  val worker = spawn BatchedBytesKvActor();
  await worker.get_ready();
  val listener = await network.listen_async("127.0.0.1", 16399);
  val socket = await listener.accept_async();
  loop {
    // Await ONE complete command; drain only already-buffered complete
    // frames. Unlike a fixed timer batch this never waits for 16 commands.
    const frames = await socket.read_resp2_binary_batch_async(16);
    let mut List<Tuple[int, Bytes, Bytes]> commands = [];
    let int terminate = 0;
    let int i = 0;
    loop {
      if i == frames.size then break; fi
      const Tuple[int, string, Bytes, Bytes] frame = frames.get(i);
      const int kind = frame[0];
      if kind == 0; do
        terminate = 1;
        break;
      fi
      if kind == 5; do
        terminate = 2;
        break;
      fi
      commands.add((kind, frame[2], frame[3]));
      i = i + 1;
    }

    if commands.size > 0; do
      worker.send(commands);
      val output = (await worker.outputs.next()).value.unwrap();
      const List<Tuple[string, Bytes]> results = output.value;
      // Enforce exact cardinality. Wrong-length actor replies are fatal to
      // this session; never permit a shifted or cross-request RESP stream.
      if results.size != commands.size; do
        await socket.close_async();
        await listener.close_async();
        let mut List<Tuple[int, Bytes, Bytes]> shutdown_batch = [];
        worker.send(shutdown_batch);
        await worker.get_done();
        return;
      fi
      await socket.write_resp2_binary_batch_async(results);
    fi

    if terminate != 0; do
      if terminate == 2; do
        const Tuple[int, string, Bytes, Bytes] quit_frame = frames.get(i);
        await socket.write_resp2_binary_async("OK", quit_frame[3]);
      fi
      await socket.close_async();
      await listener.close_async();
      let mut List<Tuple[int, Bytes, Bytes]> shutdown_batch = [];
      worker.send(shutdown_batch);
      await worker.get_done();
      return;
    fi
  }
}
