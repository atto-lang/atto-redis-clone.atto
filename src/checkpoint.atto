// Atto Redis clone checkpoint contract.
// NATIVE_COMPILE=NOT_EXECUTED. All sync/disk APIs are proposed contracts.

async fnc checkpoint(
  KvDatabase db, ActorRef<WalWriter> wal, SegmentStore disk
) -> Result<u64, StorageError> ::
  // Pause admissions and DRAIN every in-flight shard command through WAL+apply;
  // pausing mailbox delivery alone does not establish a consistent cut.
  // The runtime primitive owns/relinquishes its admission fence internally.
  // It must drain whole commands before taking the WAL durable barrier and
  // return frozen immutable generations; no resource is released twice.
  val cut = await db.freeze_at_global_durable_barrier(wal)?;
  val fence_lsn = cut.fence_lsn;
  val frozen = cut.into_owned_generations();

  val segments = await disk.write_sorted_sst_and_fsync(rt take frozen)?;
  val manifest = await disk.prepare_global_manifest(
    rt take segments, fence_lsn
  )?;
  await disk.publish_manifest_and_fsync_parent(rt take manifest)?;

  // Prune only through the GLOBAL durable fence; never max(shard marks).
  await disk.prune_wal_through_global_fence(fence_lsn)?;
  return Ok(fence_lsn);
end

async fnc spill_if_needed(
  ActorRef<KvShard> shard, ActorRef<WalWriter> wal,
  SegmentStore disk, u64 per_shard_budget
) -> Result<void, StorageError> ::
  val durable_lsn = await wal.sync_barrier()?;
  val frozen = await shard.rotate_memtable(per_shard_budget)?;
  if frozen as const generation then
    // Capture generation identity BEFORE moving its payload.
    val generation_id = generation.generation_id;
    val segment = await disk.write_sorted_sst_and_fsync(rt take generation)?;
    // Manifest is committed by borrowing the segment metadata; the actor
    // receives its ownership only after the durable publication completes.
    await disk.atomic_add_segment_to_manifest(rt borrow segment)?;
    await shard.install_persisted_segment(
      rt take segment, generation_id
    )?;
  fi
  return Ok();
end
